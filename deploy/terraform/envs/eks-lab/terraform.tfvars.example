# cp terraform.tfvars.example terraform.tfvars  (terraform.tfvars is gitignored)

name            = "nd-eks-lab"
region          = "ap-northeast-2"
cluster_version = "1.35"

# Two AZs; the first holds Prometheus and the backend (EBS), so it gets more workers.
availability_zones  = ["ap-northeast-2a", "ap-northeast-2c"]
node_instance_types = ["t3a.medium"]
node_counts         = [2, 1]

# Zone and wildcard certificate from envs/dns (apply that stack first).
domain = "netdoc.cloud"

# Cluster admins besides the GitHub Actions role (found automatically). Put the
# role you run Terraform/kubectl with here: `aws sts get-caller-identity`, and for
# an SSO session use the IAM role ARN from the IAM console (…/AWSReservedSSO_…).
admin_role_arns = ["arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/ap-northeast-2/AWSReservedSSO_AdministratorAccess_0000000000000000"]

# Optional IAM Identity Center role ARNs for trusted lab operators.
team_role_arns = []
