# cp terraform.tfvars.example terraform.tfvars  (terraform.tfvars is gitignored)

name            = "nd-eks-lab"
region          = "ap-northeast-2"
cluster_version = "1.35"

# Fixed at three workers for incident demos (min = desired = max).
node_instance_types = ["t3a.medium"]
node_count          = 3

# Replace the example with trusted public IPv4 /32s for kubectl and ALB HTTPS.
team_api_cidrs = ["203.0.113.25/32"]

# Replace with an issued ACM certificate for the team subdomain in this region.
team_alb_certificate_arn = "arn:aws:acm:ap-northeast-2:123456789012:certificate/00000000-0000-0000-0000-000000000000"

# Optional IAM Identity Center role ARNs for trusted lab operators.
team_role_arns = []
