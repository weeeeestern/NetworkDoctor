   "targets": [
    {
     "expr": "sum by (node) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|lxc.*|cilium.*|tailscale.*|docker.*\"}[5m]) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\")))",
     "legendFormat": "{{node}} rx",
     "refId": "A",
