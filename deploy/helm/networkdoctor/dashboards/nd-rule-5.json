     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "sum by (node) (rate(ebpf_tcp_connect_attempts_total{node=~\"$node\"}[5m]))",
     "legendFormat": "{{node}} attempts",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "sum by (node) (rate(ebpf_tcp_connections_short_lived_total{node=~\"$node\"}[5m]))",
     "legendFormat": "{{node}} short-lived",
     "refId": "B",
     "datasource": {
