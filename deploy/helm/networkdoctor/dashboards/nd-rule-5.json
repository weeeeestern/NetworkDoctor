    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "sum by (node) (node_sockstat_TCP_alloc * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\")))",
     "legendFormat": "{{node}} TCP alloc",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "sum by (node) (node_sockstat_TCP_tw * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\")))",
     "legendFormat": "{{node}} TCP tw",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "sum by (node) (node_sockstat_UDP_inuse * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\")))",
     "legendFormat": "{{node}} UDP inuse",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 18
   },
   "id": 8
  },
  {
   "type": "timeseries",
   "title": "TCP connect attempts / short-lived conns by node",
   "description": "Connection churn feeds the conntrack table.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0,
     "custom": {
