  {
   "type": "stat",
   "title": "R7 app 5xx",
   "description": "5xx ratio/5%, forced to 0 while any node retransmits > 0.2/s (the rule's unless clause).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
