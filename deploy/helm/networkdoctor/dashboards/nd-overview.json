   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 45
   },
   "id": 12
  },
  {
   "type": "timeseries",
   "title": "Client DNS p99 latency by node (eBPF)",
   "description": "What pods on each node actually experience, regardless of which CoreDNS answered.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "thresholds": {
      "mode": "absolute",
