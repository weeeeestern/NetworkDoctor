    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "auto",
    "textMode": "auto",
    "orientation": "auto"
   },
   "targets": [
    {
     "expr": "clamp_min(max(histogram_quantile(0.99, sum by (le, namespace, service) (rate(coredns_dns_request_duration_seconds_bucket[5m])))) / 0.25, scalar(max(sum by (namespace, service) (rate(coredns_dns_responses_total{rcode=\"SERVFAIL\"}[5m])) / clamp_min(sum by (namespace, service) (rate(coredns_dns_responses_total[5m])), 0.001)) / 0.05 or vector(0))) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "links": [
    {
     "title": "R4 CoreDNS",
     "url": "/d/nd-rule-4"
    }
   ],
   "gridPos": {
    "h": 5,
    "w": 3,
    "x": 9,
    "y": 1
   },
   "id": 5
  },
  {
   "type": "stat",
   "title": "R5 DNS×CT",
   "description": "min(slow DNS/0.1, conntrack/50%) — both must exceed (same-node check omitted here).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 0.7
