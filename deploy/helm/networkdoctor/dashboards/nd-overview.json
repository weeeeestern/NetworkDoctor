   "id": 6
  },
  {
   "type": "timeseries",
   "title": "HTTP 5xx ratio by service",
   "description": "Rule 7 trigger: > 5% 5xx for 3m while the network is quiet.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     },
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "sum by (namespace, service) (rate(http_requests_total{status=~\"5..\", service=~\"$service\"}[5m])) / clamp_min(sum by (namespace, service) (rate(http_requests_total{service=~\"$service\"}[5m])), 0.001)",
     "legendFormat": "{{namespace}}/{{service}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 12,
