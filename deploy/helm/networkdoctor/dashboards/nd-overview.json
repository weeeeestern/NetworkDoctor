{
 "uid": "nd-overview",
 "title": "NetworkDoctor / Overview",
 "description": "Always-on layer map, L7 down to the CNI. Every panel reuses the exact query and threshold of the scenario rule that watches that layer, so a line crossing a threshold here is the rule about to fire.",
 "tags": [
  "networkdoctor",
  "overview"
 ],
 "timezone": "",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "links": [
  {
   "type": "dashboards",
   "tags": [
    "networkdoctor"
   ],
   "asDropdown": true,
   "title": "NetworkDoctor",
   "includeVars": true,
   "keepTime": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "current": {}
   },
   {
    "name": "node",
    "label": "node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(ebpf_tcp_retransmits_total, node)",
     "refId": "var-node"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "sort": 1
   },
   {
    "name": "service",
    "label": "service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(http_requests_total, service)",
     "refId": "var-service"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "enable": true,
    "expr": "ALERTS{source=\"networkdoctor\", alertstate=\"firing\"}",
    "name": "NetworkDoctor firing",
    "iconColor": "rgba(255, 96, 96, 1)",
    "step": "30s",
    "titleFormat": "{{alertname}}",
    "tagKeys": "rule_id,node,service"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Rule firing proximity — 100% = trigger condition met",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "panels": []
  },
  {
   "type": "stat",
   "title": "R1 congestion",
   "description": "min(p99/500ms, retransmits/0.2) — both must exceed (same-node check omitted here).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 0.7
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "auto",
    "textMode": "auto",
    "orientation": "auto"
   },
   "targets": [
    {
     "expr": "clamp_max(max(histogram_quantile(0.99, sum by (le, namespace, service, node) (rate(http_request_duration_seconds_bucket[5m])))) / 0.5, scalar(max(sum by (node) (rate(ebpf_tcp_retransmits_total[5m]))) / 0.2 or vector(0))) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "links": [
    {
     "title": "R1 congestion",
     "url": "/d/nd-rule-1"
    }
   ],
   "gridPos": {
    "h": 5,
    "w": 3,
    "x": 0,
    "y": 1
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "R2 kernel",
   "description": "max(softnet drops/1, NIC rx drops/10) — either fires.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 0.7
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "auto",
    "textMode": "auto",
    "orientation": "auto"
   },
   "targets": [
    {
     "expr": "clamp_min(max(sum by (node) (rate(node_softnet_dropped_total[5m]) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\")))) / 1, scalar(max(sum by (node) (rate(node_network_receive_drop_total{device!~\"lo|veth.*|lxc.*|cilium.*|tailscale.*|docker.*\"}[5m]) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\")))) / 10 or vector(0))) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "links": [
    {
     "title": "R2 kernel",
     "url": "/d/nd-rule-2"
    }
   ],
   "gridPos": {
    "h": 5,
    "w": 3,
    "x": 3,
    "y": 1
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "R3 conntrack",
   "description": "max(usage/80%, CT insert failures where 0.01/s = 100%).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 0.7
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "background",
    "graphMode": "area",
    "justifyMode": "auto",
    "textMode": "auto",
    "orientation": "auto"
   },
   "targets": [
    {
     "expr": "clamp_min(max((node_nf_conntrack_entries / node_nf_conntrack_entries_limit) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\"))) / 0.8, scalar(max(sum by (node) (rate(hubble_drop_total{reason=\"CT_MAP_INSERTION_FAILED\"}[5m]) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9965\", \"internal_ip\", \"(.*)\")))) / 0.01 or vector(0))) or vector(0)",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "links": [
    {
     "title": "R3 conntrack",
     "url": "/d/nd-rule-3"
    }
   ],
   "gridPos": {
    "h": 5,
    "w": 3,
    "x": 6,
    "y": 1
   },
   "id": 4
  },
  {
   "type": "stat",
   "title": "R4 CoreDNS",
   "description": "max(p99/250ms, SERVFAIL ratio/5%).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "thresholds": {
      "mode": "absolute",
