{
 "uid": "nd-overview",
 "title": "NetworkDoctor / Overview",
 "description": "Always-on layer map, L7 down to the CNI. Every panel reuses the exact query and threshold of the scenario rule that watches that layer, so a line crossing a threshold here is the rule about to fire.",
 "tags": [
  "networkdoctor",
  "overview"
 ],
 "timezone": "",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "links": [
  {
   "type": "dashboards",
   "tags": [
    "networkdoctor"
   ],
   "asDropdown": true,
   "title": "NetworkDoctor",
   "includeVars": true,
   "keepTime": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "current": {}
   },
   {
    "name": "node",
    "label": "node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(ebpf_tcp_retransmits_total, node)",
     "refId": "var-node"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "sort": 1
   },
   {
    "name": "service",
    "label": "service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(http_requests_total, service)",
     "refId": "var-service"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "enable": true,
    "expr": "ALERTS{source=\"networkdoctor\", alertstate=\"firing\"}",
    "name": "NetworkDoctor firing",
    "iconColor": "rgba(255, 96, 96, 1)",
    "step": "30s",
    "titleFormat": "{{alertname}}",
    "tagKeys": "rule_id,node,service"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Rule firing proximity",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "panels": []
  },
  {
   "type": "bargauge",
   "title": "Rule firing proximity — 100% = trigger condition met, for: timer starts",
   "description": "Each bar replays its rule's trigger query divided by the rule threshold, so all eight rules land on one scale: how close is this rule to firing. Yellow from 70%, red at 100%. Actually-firing alerts (trigger held for the rule's `for:` duration) appear in the panel below. Panel links (top-left corner menu) jump to each rule's incident dashboard.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "max": 1.2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "#EAB839",
        "value": 0.7
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "showUnfilled": true,
    "valueMode": "color"
   },
   "targets": [
    {
     "expr": "clamp_max(max(histogram_quantile(0.99, sum by (le, namespace, service, node) (rate(http_request_duration_seconds_bucket[5m])))) / 0.5, scalar(max(sum by (node) (rate(ebpf_tcp_retransmits_total[5m]))) / 0.2 or vector(0))) or vector(0)",
     "legendFormat": "Rule 1 · Network congestion  (p99 AND retransmits — lower of the two)",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "clamp_min(max(sum by (node) (rate(node_softnet_dropped_total[5m]) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\")))) / 1, scalar(max(sum by (node) (rate(node_network_receive_drop_total{device!~\"lo|veth.*|lxc.*|cilium.*|tailscale.*|docker.*\"}[5m]) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\")))) / 10 or vector(0))) or vector(0)",
     "legendFormat": "Rule 2 · Kernel bottleneck  (softnet OR NIC drops — higher of the two)",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "clamp_min(max((node_nf_conntrack_entries / node_nf_conntrack_entries_limit) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\"))) / 0.8, scalar(max(sum by (node) (rate(hubble_drop_total{reason=\"CT_MAP_INSERTION_FAILED\"}[5m]) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9965\", \"internal_ip\", \"(.*)\")))) / 0.01 or vector(0))) or vector(0)",
     "legendFormat": "Rule 3 · Conntrack exhaustion  (usage/80% OR CT insert failures)",
     "refId": "C",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "clamp_min(max(histogram_quantile(0.99, sum by (le, namespace, service) (rate(coredns_dns_request_duration_seconds_bucket[5m])))) / 0.25, scalar(max(sum by (namespace, service) (rate(coredns_dns_responses_total{rcode=\"SERVFAIL\"}[5m])) / clamp_min(sum by (namespace, service) (rate(coredns_dns_responses_total[5m])), 0.001)) / 0.05 or vector(0))) or vector(0)",
     "legendFormat": "Rule 4 · CoreDNS degradation  (p99/250ms OR SERVFAIL/5%)",
     "refId": "D",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "clamp_max(max(sum by (node) (rate(ebpf_dns_slow_total[5m]))) / 0.1, scalar(max((node_nf_conntrack_entries / node_nf_conntrack_entries_limit) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\"))) / 0.5 or vector(0))) or vector(0)",
     "legendFormat": "Rule 5 · DNS × conntrack  (slow DNS AND conntrack/50% — lower of the two)",
     "refId": "E",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "max(sum by (node) (rate(ebpf_tcp_connect_failed_total[5m])) / clamp_min(sum by (node) (rate(ebpf_tcp_connect_attempts_total[5m])), 0.001)) / 0.1 or vector(0)",
     "legendFormat": "Rule 6 · Node-localized failure  (worst node connect-fail ratio / 10%)",
     "refId": "F",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "(max(sum by (namespace, service) (rate(http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum by (namespace, service) (rate(http_requests_total[5m])), 0.001)) / 0.05) * scalar(max(sum by (node) (rate(ebpf_tcp_retransmits_total[5m]))) <= bool 0.2) or vector(0)",
     "legendFormat": "Rule 7 · App-induced  (5xx/5%, zeroed while the network is noisy)",
     "refId": "G",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "max(sum by (node) (rate(hubble_drop_total{reason=~\"POLICY_DENIED|POLICY_DENY\"}[5m]) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9965\", \"internal_ip\", \"(.*)\")))) / 0.01 or vector(0)",
     "legendFormat": "Rule 8 · NetworkPolicy denied  (POLICY_DENIED drops, 0.01/s = 100%)",
     "refId": "H",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "links": [
    {
     "title": "Rule 1 incident dashboard",
     "url": "/d/nd-rule-1"
    },
    {
     "title": "Rule 2 incident dashboard",
     "url": "/d/nd-rule-2"
    },
    {
     "title": "Rule 3 incident dashboard",
     "url": "/d/nd-rule-3"
    },
    {
     "title": "Rule 4 incident dashboard",
     "url": "/d/nd-rule-4"
    },
    {
     "title": "Rule 5 incident dashboard",
     "url": "/d/nd-rule-5"
    },
    {
     "title": "Rule 6 incident dashboard",
     "url": "/d/nd-rule-6"
    },
    {
     "title": "Rule 7 incident dashboard",
     "url": "/d/nd-rule-7"
    },
    {
     "title": "Rule 8 incident dashboard",
     "url": "/d/nd-rule-8"
    }
   ],
   "gridPos": {
    "h": 9,
    "w": 24,
    "x": 0,
    "y": 1
   },
   "id": 2
  },
  {
   "type": "row",
   "title": "Firing alerts",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 10
   },
   "id": 3,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "Firing NetworkDoctor alerts",
   "description": "Every scenario rule currently firing. Jump to the matching nd-rule-N incident dashboard.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "count by (rule_id, alertname) (ALERTS{source=\"networkdoctor\", alertstate=\"firing\"})",
     "legendFormat": "{{rule_id}} {{alertname}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 11
   },
   "id": 4
  },
  {
   "type": "row",
   "title": "L7 — Application (Rule 1·7)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 19
   },
   "id": 5,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "App p99 latency by service/node",
   "description": "Rule 1 trigger: > 500ms p99 for 3m (with retransmits on the same node).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le, namespace, service, node) (rate(http_request_duration_seconds_bucket{node=~\"$node\", service=~\"$service\"}[5m])))",
     "legendFormat": "{{namespace}}/{{service}} @ {{node}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
