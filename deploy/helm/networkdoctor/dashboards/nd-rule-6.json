{
 "uid": "nd-rule-6",
 "title": "NetworkDoctor / Rule 6 — Node-Localized Failure",
 "description": "Connect failures concentrated on exactly one node — keep node=All so the contrast against healthy peers is visible. Supporting: everything node-local. Excluded: single-workload (app) causes, DNS, conntrack, policy.",
 "tags": [
  "networkdoctor",
  "incident",
  "rule-6"
 ],
 "timezone": "",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "links": [
  {
   "type": "dashboards",
   "tags": [
    "networkdoctor"
   ],
   "asDropdown": true,
   "title": "NetworkDoctor",
   "includeVars": true,
   "keepTime": true
  }
 ],
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "refresh": 1,
    "current": {}
   },
   {
    "name": "node",
    "label": "node",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(ebpf_tcp_retransmits_total, node)",
     "refId": "var-node"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "sort": 1
   },
   {
    "name": "service",
    "label": "service",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "query": {
     "query": "label_values(http_requests_total, service)",
     "refId": "var-service"
    },
    "refresh": 2,
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "selected": true,
     "text": [
      "All"
     ],
     "value": [
      "$__all"
     ]
    },
    "sort": 1
   }
  ]
 },
 "annotations": {
  "list": [
   {
    "builtIn": 1,
    "datasource": {
     "type": "grafana",
     "uid": "-- Grafana --"
    },
    "enable": true,
    "hide": true,
    "iconColor": "rgba(0, 211, 255, 1)",
    "name": "Annotations & Alerts",
    "type": "dashboard"
   },
   {
    "datasource": {
     "type": "prometheus",
     "uid": "${datasource}"
    },
    "enable": true,
    "expr": "ALERTS{source=\"networkdoctor\", rule_id=\"rule-6\", alertstate=\"firing\"}",
    "name": "rule-6 firing",
    "iconColor": "rgba(255, 96, 96, 1)",
    "step": "30s",
    "titleFormat": "{{alertname}}",
    "tagKeys": "rule_id,node,service"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Trigger",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "id": 1,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "TCP connect failure ratio by node",
   "description": "Rule 6 trigger: > 10% on exactly one node for 2m. Keep node=All to see the contrast.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "line"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.1
       }
      ]
     },
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "sum by (node) (rate(ebpf_tcp_connect_failed_total{node=~\"$node\"}[5m])) / clamp_min(sum by (node) (rate(ebpf_tcp_connect_attempts_total{node=~\"$node\"}[5m])), 0.001)",
     "legendFormat": "{{node}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 1
   },
   "id": 2
  },
  {
   "type": "row",
   "title": "Supporting",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 9
   },
   "id": 3,
   "panels": []
  },
  {
   "type": "timeseries",
   "title": "TCP retransmits by node",
   "description": "Rule 1 trigger / Rule 7 exclusion threshold: 0.2/s.",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "sum by (node) (rate(ebpf_tcp_retransmits_total{node=~\"$node\"}[5m]))",
     "legendFormat": "{{node}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 10
   },
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "TCP p99 sRTT by node",
   "description": "eBPF smoothed RTT (µs histogram converted to seconds).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le, node) (rate(ebpf_tcp_srtt_microseconds_bucket{node=~\"$node\"}[5m]))) / 1e6",
     "legendFormat": "{{node}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 10
   },
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Physical NIC drops by node",
   "description": "Rule 2 trigger: rx drops > 10/s on physical interfaces (veth/cilium/etc. excluded).",
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "min": 0,
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "showPoints": "never",
      "spanNulls": true,
      "thresholdsStyle": {
       "mode": "off"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "expr": "sum by (node) (rate(node_network_receive_drop_total{device!~\"lo|veth.*|lxc.*|cilium.*|tailscale.*|docker.*\"}[5m]) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\")))",
     "legendFormat": "{{node}} rx",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    },
    {
     "expr": "sum by (node) (rate(node_network_transmit_drop_total{device!~\"lo|veth.*|lxc.*|cilium.*|tailscale.*|docker.*\"}[5m]) * on (instance) group_left (node) max by (instance, node) (label_replace(kube_node_info{node=~\"$node\"}, \"instance\", \"$1:9100\", \"internal_ip\", \"(.*)\")))",
     "legendFormat": "{{node}} tx",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     }
    }
   ],
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 18
   },
   "id": 6
  },
