# Copy to .env on the gateway VM. Never commit .env.
#
# Master key: admin credential for the proxy (issue/revoke virtual keys).
# Generate one:  echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-CHANGE-ME

# Postgres for key/usage storage (local container).
POSTGRES_PASSWORD=CHANGE-ME
DATABASE_URL=postgresql://litellm:CHANGE-ME@db:5432/litellm

# Provider credentials. Fill only what config.yaml uses.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-2
